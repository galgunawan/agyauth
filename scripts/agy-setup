#!/bin/bash
# agy-setup — Setup multi-account Antigravity with symlinks
# UNIQUE files per account: antigravity-oauth-token, installation_id, log/, last_check.timestamp
# SHARED files via symlinks: history.jsonl, conversations/, settings.json, knowledge/, brain/, keybindings.json

GREEN='\033[0;32m'
CYAN='\033[0;36m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
NC='\033[0m'

BASE="$HOME/.gemini"
SHARED="$BASE/agy-shared"
ORIGINAL="$BASE/antigravity-cli"

# Detect sudo
if [ "$EUID" -ne 0 ] && command -v sudo &>/dev/null; then
    SUDO="sudo"
else
    SUDO=""
fi

# Determine bin directory
if [ -w "/usr/local/bin" ] || [ -n "$SUDO" ]; then
    BIN_DIR="/usr/local/bin"
else
    BIN_DIR="$HOME/.local/bin"
    mkdir -p "$BIN_DIR"
fi

# Files/folders SHARED across all accounts
SHARED_ITEMS=(
    "history.jsonl"
    "conversations"
    "settings.json"
    "knowledge"
    "brain"
    "keybindings.json"
    "implicit"
    "cache"
    "bin"
    "updater"
    "packages"
)

# Files/folders UNIQUE per account (not shared)
UNIQUE_ITEMS=(
    "antigravity-oauth-token"
    "installation_id"
    "log"
    "last_check.timestamp"
    "cli.log"
)

echo -e "${CYAN}================================================${NC}"
echo -e "${GREEN}   Antigravity Multi-Account Setup (Symlinks)   ${NC}"
echo -e "${CYAN}================================================${NC}"
echo ""

# Function to create wrapper for one account
create_wrapper() {
    local acc_name="$1"
    local acc_dir="$BASE/agy-$acc_name"
    local wrapper="$BIN_DIR/agy-$acc_name"
    local tmp=$(mktemp)
    cat > "$tmp" <<EOF
#!/bin/bash
ACCT_DIR="$acc_dir"
ORIGINAL="$ORIGINAL"
rm -f "\$ORIGINAL"
ln -sf "\$ACCT_DIR" "\$ORIGINAL"
exec agy "\$@"
EOF
    $SUDO mv "$tmp" "$wrapper"
    $SUDO chmod +x "$wrapper"
}

# Check if already set up
if [ -d "$SHARED" ]; then
    echo -e "${YELLOW}Shared folder already exists at: $SHARED${NC}"
    echo ""
    echo -e "Repairing missing wrapper commands..."
    FIXED=0
    for dir in "$BASE"/agy-*/; do
        acc=$(basename "$dir" | sed 's/^agy-//')
        [ "$acc" = "shared" ] && continue
        wrapper="$BIN_DIR/agy-$acc"
        if [ ! -f "$wrapper" ]; then
            create_wrapper "$acc"
            echo -e "  ${GREEN}✔${NC} Wrapper created: agy-$acc (→ $BIN_DIR/)"
            FIXED=$((FIXED + 1))
        else
            echo -e "  ${CYAN}·${NC} agy-$acc already exists, skipping"
        fi
    done
    echo ""
    if [ "$FIXED" -gt 0 ]; then
        echo -e "${GREEN}✔ $FIXED wrapper(s) successfully repaired!${NC}"
    else
        echo -e "${CYAN}All wrappers are complete. No repairs needed.${NC}"
    fi
    echo ""
    echo -e "Available commands:"
    for dir in "$BASE"/agy-*/; do
        acc=$(basename "$dir" | sed 's/^agy-//')
        [ "$acc" = "shared" ] && continue
        echo -e "  ${YELLOW}agy-$acc${NC}"
    done
    echo -e "  ${YELLOW}agyauth${NC}  ← interactive manager"
    exit 0
fi

# Check if original folder exists
if [ ! -d "$ORIGINAL" ]; then
    echo -e "${RED}Folder antigravity-cli not found at $ORIGINAL${NC}"
    echo "Make sure Antigravity has been run at least once."
    exit 1
fi

echo -e "Step 1: Creating shared directory from current data..."
mkdir -p "$SHARED"

# Move all shared files to shared folder
for item in "${SHARED_ITEMS[@]}"; do
    if [ -e "$ORIGINAL/$item" ] && [ ! -L "$ORIGINAL/$item" ]; then
        mv "$ORIGINAL/$item" "$SHARED/$item"
        echo -e "  ${GREEN}✔${NC} Moved: $item → agy-shared/"
    fi
done

echo ""
echo -e "Step 2: Creating first account directory from current account..."

# Get first account name from user
read -p "Name for current active account (e.g., main, account1): " FIRST_ACCOUNT
if [ -z "$FIRST_ACCOUNT" ]; then
    FIRST_ACCOUNT="main"
fi

ACCT_DIR="$BASE/agy-$FIRST_ACCOUNT"
mkdir -p "$ACCT_DIR"

# Move UNIQUE files to first account folder
for item in "${UNIQUE_ITEMS[@]}"; do
    if [ -e "$ORIGINAL/$item" ] && [ ! -L "$ORIGINAL/$item" ]; then
        mv "$ORIGINAL/$item" "$ACCT_DIR/$item"
        echo -e "  ${GREEN}✔${NC} Moved (unique): $item → agy-$FIRST_ACCOUNT/"
    fi
done

# Ensure all shared items exist in SHARED (so symlinks are not broken and work when created)
for item in "${SHARED_ITEMS[@]}"; do
    if [ ! -e "$SHARED/$item" ]; then
        case "$item" in
            history.jsonl|settings.json|keybindings.json)
                touch "$SHARED/$item"
                ;;
            *)
                mkdir -p "$SHARED/$item"
                ;;
        esac
    fi
done

# Create symlinks from first account to shared
for item in "${SHARED_ITEMS[@]}"; do
    ln -sf "$SHARED/$item" "$ACCT_DIR/$item"
    echo -e "  ${CYAN}🔗${NC} Symlink: agy-$FIRST_ACCOUNT/$item → agy-shared/$item"
done

# Backup and replace original folder with symlink to first account
echo ""
echo -e "Step 3: Replacing antigravity-cli folder with symlink to active account..."
rm -rf "$ORIGINAL"
ln -sf "$ACCT_DIR" "$ORIGINAL"
echo -e "  ${GREEN}✔${NC} $ORIGINAL → agy-$FIRST_ACCOUNT"

# Create wrapper command
WRAPPER="$BIN_DIR/agy-$FIRST_ACCOUNT"
TMP_WRAPPER=$(mktemp)
cat > "$TMP_WRAPPER" <<EOF
#!/bin/bash
# Account wrapper: $FIRST_ACCOUNT
ACCT_DIR="$ACCT_DIR"
ORIGINAL="$ORIGINAL"

# Point antigravity-cli to this account directory
rm -f "\$ORIGINAL"
ln -sf "\$ACCT_DIR" "\$ORIGINAL"

exec agy "\$@"
EOF
$SUDO mv "$TMP_WRAPPER" "$WRAPPER"
$SUDO chmod +x "$WRAPPER"
echo -e "  ${GREEN}✔${NC} Command created: agy-$FIRST_ACCOUNT (→ $BIN_DIR/)"

echo ""
echo -e "${GREEN}================================================${NC}"
echo -e "${GREEN}  Setup complete! Account '$FIRST_ACCOUNT' is ready.  ${NC}"
echo -e "${GREEN}================================================${NC}"
echo ""
echo -e "Next steps:"
echo -e "  Add a new account : ${YELLOW}agy-new <account_name>${NC}"
echo -e "  Interactive manager: ${YELLOW}agyauth${NC}"
echo -e "  Run specific account: ${YELLOW}agy-$FIRST_ACCOUNT${NC}"

#!/bin/bash
# agy-new — Add a new Antigravity account with symlink to shared data

GREEN='\033[0;32m'
CYAN='\033[0;36m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
NC='\033[0m'

BASE="$HOME/.gemini"
SHARED="$BASE/agy-shared"
ORIGINAL="$BASE/antigravity-cli"

# Detect sudo
if [ "$EUID" -ne 0 ] && command -v sudo &>/dev/null; then
    SUDO="sudo"
else
    SUDO=""
fi

# Determine bin directory
if [ -w "/usr/local/bin" ] || [ -n "$SUDO" ]; then
    BIN_DIR="/usr/local/bin"
else
    BIN_DIR="$HOME/.local/bin"
    mkdir -p "$BIN_DIR"
fi

SHARED_ITEMS=(
    "history.jsonl"
    "conversations"
    "settings.json"
    "knowledge"
    "brain"
    "keybindings.json"
    "implicit"
    "cache"
    "bin"
    "updater"
    "packages"
)

NAME="$1"
if [ -z "$NAME" ]; then
    read -p "New account name (e.g., account2, office): " NAME
fi
if [ -z "$NAME" ]; then
    echo -e "${RED}Account name cannot be empty.${NC}"
    exit 1
fi

ACCT_DIR="$BASE/agy-$NAME"

if [ -d "$ACCT_DIR" ]; then
    echo -e "${RED}Account 'agy-$NAME' already exists!${NC}"
    exit 1
fi

if [ ! -d "$SHARED" ]; then
    echo -e "${RED}Shared folder does not exist. Run 'agy-setup' first.${NC}"
    exit 1
fi

echo -e "${CYAN}Creating new account: agy-$NAME${NC}"
mkdir -p "$ACCT_DIR"
mkdir -p "$ACCT_DIR/log"

# Generate unique installation_id
NEW_ID=$(cat /proc/sys/kernel/random/uuid)
echo "$NEW_ID" > "$ACCT_DIR/installation_id"
echo -e "  ${GREEN}✔${NC} new installation_id: $NEW_ID"

# Create symlinks to shared
for item in "${SHARED_ITEMS[@]}"; do
    if [ ! -e "$SHARED/$item" ]; then
        case "$item" in
            history.jsonl|settings.json|keybindings.json)
                touch "$SHARED/$item"
                ;;
            *)
                mkdir -p "$SHARED/$item"
                ;;
        esac
    fi
    ln -sf "$SHARED/$item" "$ACCT_DIR/$item"
    echo -e "  ${CYAN}🔗${NC} Symlink: $item → agy-shared/$item"
done

# Create wrapper command
WRAPPER="$BIN_DIR/agy-$NAME"
TMP_WRAPPER=$(mktemp)
cat > "$TMP_WRAPPER" <<EOF
#!/bin/bash
# Account wrapper: $NAME
ACCT_DIR="$ACCT_DIR"
ORIGINAL="$ORIGINAL"

# Switch symlink antigravity-cli to this account
rm -f "\$ORIGINAL"
ln -sf "\$ACCT_DIR" "\$ORIGINAL"

exec agy "\$@"
EOF
$SUDO mv "$TMP_WRAPPER" "$WRAPPER"
$SUDO chmod +x "$WRAPPER"
echo -e "  ${GREEN}✔${NC} Wrapper created: agy-$NAME (→ $BIN_DIR/)"

echo ""
echo -e "${GREEN}Account 'agy-$NAME' successfully created!${NC}"
echo ""
echo -e "Next steps:"
echo -e "  1. Run ${YELLOW}agy-$NAME${NC} to start and log in to this account"
echo -e "  2. Log in with a different Google account when prompted"
echo -e "  3. Once logged in, this account will store its token separately"
echo -e "  4. History & config are automatically shared with other accounts ✅"

#!/bin/bash
# agyauth v2 — Antigravity Multi-Account Manager (Premium TUI)

BASE="$HOME/.gemini"
SHARED="$BASE/agy-shared"
ORIGINAL="$BASE/antigravity-cli"

# ── Warna ──────────────────────────────────────────────────────
C_RESET='\033[0m'
C_BOLD='\033[1m'
C_DIM='\033[2m'
C_GREEN='\033[38;5;84m'
C_CYAN='\033[38;5;51m'
C_BLUE='\033[38;5;75m'
C_YELLOW='\033[38;5;220m'
C_RED='\033[38;5;203m'
C_PURPLE='\033[38;5;141m'
C_WHITE='\033[38;5;255m'
C_GRAY='\033[38;5;240m'
C_BG_SEL='\033[48;5;236m'
C_BG_HDR='\033[48;5;234m'

# ── Box Drawing ─────────────────────────────────────────────────
BOX_TL='╭'; BOX_TR='╮'; BOX_BL='╰'; BOX_BR='╯'
BOX_H='─'; BOX_V='│'; BOX_ML='├'; BOX_MR='┤'
SEP='·'

# ── Ukuran terminal ─────────────────────────────────────────────
TERM_W=$(tput cols)
TERM_H=$(tput lines)

# Track apakah TUI sudah diaktifkan (agar trap tidak menghapus output non-TUI)
TUI_ACTIVE=0
trap 'tput cnorm; [ $TUI_ACTIVE -eq 1 ] && tput rmcup; exit' INT TERM EXIT

# ── Helper: buat baris horizontal ──────────────────────────────
hline() {
    local char="${1:-$BOX_H}" len="${2:-$TERM_W}"
    printf '%*s' "$len" | tr ' ' "$char"
}

# ── Helper: center text ─────────────────────────────────────────
center() {
    local text="$1" width="${2:-$TERM_W}"
    local clean=$(echo -e "$text" | sed 's/\x1b\[[0-9;]*m//g')
    local pad=$(( (width - ${#clean}) / 2 ))
    printf '%*s%b%s\n' "$pad" '' "$text" "$C_RESET"
}

# ── Helper: box ─────────────────────────────────────────────────
draw_box() {
    local title="$1" width="${2:-60}"
    local inner=$((width - 2))
    echo -e "${C_CYAN}${BOX_TL}$(hline $BOX_H $inner)${BOX_TR}${C_RESET}"
    if [ -n "$title" ]; then
        local tlen=${#title}
        local lpad=$(( (inner - tlen - 2) / 2 ))
        local rpad=$(( inner - tlen - 2 - lpad ))
        echo -e "${C_CYAN}${BOX_V}${C_RESET}$(printf '%*s' $lpad '') ${C_BOLD}${C_WHITE}${title}${C_RESET} $(printf '%*s' $rpad '')${C_CYAN}${BOX_V}${C_RESET}"
        echo -e "${C_CYAN}${BOX_ML}$(hline $BOX_H $inner)${BOX_MR}${C_RESET}"
    fi
}

draw_box_bottom() {
    local width="${1:-60}"
    local inner=$((width - 2))
    echo -e "${C_CYAN}${BOX_BL}$(hline $BOX_H $inner)${BOX_BR}${C_RESET}"
}

# ── Helper: format baris dalam box ─────────────────────────────
box_row() {
    local label="$1" value="$2" width="${3:-60}"
    local inner=$((width - 2))
    local llen=${#label}
    local clean_val=$(echo -e "$value" | sed 's/\x1b\[[0-9;]*m//g')
    local vlen=${#clean_val}
    local dots_len=$((inner - llen - vlen - 4))
    [ $dots_len -lt 1 ] && dots_len=1
    local dots=$(printf '%*s' $dots_len | tr ' ' "$SEP")
    echo -e "${C_CYAN}${BOX_V}${C_RESET} ${C_GRAY}${label}${C_RESET} ${C_DIM}${C_GRAY}${dots}${C_RESET} ${value} ${C_CYAN}${BOX_V}${C_RESET}"
}

box_empty() {
    local width="${1:-60}"
    local inner=$((width - 2))
    echo -e "${C_CYAN}${BOX_V}${C_RESET}$(printf '%*s' $inner '')${C_CYAN}${BOX_V}${C_RESET}"
}

# ── Ambil data akun ─────────────────────────────────────────────
get_expiry() {
    local file="$1/antigravity-oauth-token"
    [ ! -f "$file" ] && echo "${C_RED}No Token${C_RESET}" && return
    local raw=$(jq -r '.token.expiry // empty' "$file" 2>/dev/null)
    [ -z "$raw" ] && echo "${C_GRAY}No Expiry${C_RESET}" && return

    local exp_ts=$(date -d "$raw" +%s 2>/dev/null)
    local now_ts=$(date +%s)
    local diff=$((exp_ts - now_ts))

    local formatted=$(TZ='Asia/Jakarta' date -d "$raw" '+%d %b %Y %H:%M WIB' 2>/dev/null)

    if [ $diff -lt 0 ]; then
        echo "${C_RED}✗ Expired${C_RESET}"
    elif [ $diff -lt 1800 ]; then
        echo "${C_RED}⚠ $formatted${C_RESET}"
    elif [ $diff -lt 7200 ]; then
        echo "${C_YELLOW}◑ $formatted${C_RESET}"
    else
        echo "${C_GREEN}✓ $formatted${C_RESET}"
    fi
}

get_expiry_plain() {
    local file="$1/antigravity-oauth-token"
    [ ! -f "$file" ] && echo "No Token" && return
    local raw=$(jq -r '.token.expiry // empty' "$file" 2>/dev/null)
    [ -z "$raw" ] && echo "No Expiry" && return
    TZ='Asia/Jakarta' date -d "$raw" '+%d %b %H:%M WIB' 2>/dev/null || echo "Invalid"
}

get_token_status() {
    local file="$1/antigravity-oauth-token"
    [ ! -f "$file" ] && echo "none" && return
    local raw=$(jq -r '.token.expiry // empty' "$file" 2>/dev/null)
    [ -z "$raw" ] && echo "none" && return
    local exp_ts=$(date -d "$raw" +%s 2>/dev/null)
    local now_ts=$(date +%s)
    local diff=$((exp_ts - now_ts))
    if [ $diff -lt 0 ]; then echo "expired"
    elif [ $diff -lt 1800 ]; then echo "warning"
    elif [ $diff -lt 7200 ]; then echo "expiring"
    else echo "ok"
    fi
}

get_install_id() {
    local file="$1/installation_id"
    [ -f "$file" ] && cat "$file" | cut -c1-8 || echo "N/A"
}

get_active_account() {
    [ -L "$ORIGINAL" ] && basename "$(readlink "$ORIGINAL")" | sed 's/^agy-//' || echo "unknown"
}

get_all_accounts() {
    for dir in "$BASE"/agy-*/; do
        [ -d "$dir" ] && [ "$(basename "$dir")" != "agy-shared" ] && basename "$dir" | sed 's/^agy-//'
    done
}

# ── Render menu navigasi ────────────────────────────────────────
render_menu() {
    local -n opts=$1
    local sel=$2
    local width="${3:-60}"

    for i in "${!opts[@]}"; do
        local label="${opts[$i]}"
        local inner=$((width - 4))
        local clean=$(echo -e "$label" | sed 's/\x1b\[[0-9;]*m//g')
        local pad=$((inner - ${#clean}))
        [ $pad -lt 0 ] && pad=0

        if [ "$i" -eq "$sel" ]; then
            echo -e "${C_CYAN}${BOX_V}${C_RESET} ${C_BG_SEL}${C_GREEN}${C_BOLD} ❯ ${label}$(printf '%*s' $pad '') ${C_RESET} ${C_CYAN}${BOX_V}${C_RESET}"
        else
            echo -e "${C_CYAN}${BOX_V}${C_RESET}   ${C_DIM}${label}${C_RESET}$(printf '%*s' $((pad+1)) '')${C_CYAN}${BOX_V}${C_RESET}"
        fi
    done
}

# ── Read key ────────────────────────────────────────────────────
read_key() {
    local key
    read -rsn1 key
    if [[ $key == $'\x1b' ]]; then
        read -rsn2 key2
        case "$key2" in
            '[A') echo "UP" ;;
            '[B') echo "DOWN" ;;
            '[C') echo "RIGHT" ;;
            '[D') echo "LEFT" ;;
            *) echo "ESC" ;;
        esac
    elif [[ $key == "" ]]; then echo "ENTER"
    elif [[ $key == "q" ]] || [[ $key == "Q" ]]; then echo "QUIT"
    elif [[ $key == "j" ]]; then echo "DOWN"
    elif [[ $key == "k" ]]; then echo "UP"
    else echo "OTHER"
    fi
}

# ════════════════════════════════════════════════════════════════
# ── MAIN MENU ───────────────────────────────────────────────────
# ════════════════════════════════════════════════════════════════
show_main_menu() {
    local W=66
    local selected=0

    while true; do
        local ACTIVE=$(get_active_account)
        local all=($(get_all_accounts))
        local acc_count=${#all[@]}

        # Bangun daftar item: akun dulu, lalu actions
        local items=()
        local item_types=()   # "account" atau "action"
        local item_names=()   # nama akun atau nama action

        for name in "${all[@]}"; do
            local exp=$(get_expiry_plain "$BASE/agy-$name")
            local iid=$(get_install_id "$BASE/agy-$name")
            local status=$(get_token_status "$BASE/agy-$name")
            local badge=""
            case $status in
                ok)      badge="${C_GREEN}●${C_RESET}" ;;
                expiring) badge="${C_YELLOW}◑${C_RESET}" ;;
                warning) badge="${C_RED}⚠${C_RESET}" ;;
                expired) badge="${C_RED}✗${C_RESET}" ;;
                *)       badge="${C_GRAY}○${C_RESET}" ;;
            esac
            local active_mark=""
            [ "$name" == "$ACTIVE" ] && active_mark=" ${C_CYAN}[aktif]${C_RESET}"
            items+=("$badge ${C_BOLD}${name}${C_RESET}${active_mark}  ${C_GRAY}ID:${iid}  ${exp}${C_RESET}")
            item_types+=("account")
            item_names+=("$name")
        done

        # Separator action
        items+=("${C_GRAY}────────────────────────────────────${C_RESET}")
        item_types+=("sep")
        item_names+=("")

        items+=("➕  Buat Akun Baru")
        item_types+=("action")
        item_names+=("new")

        items+=("✏️   Rename Akun")
        item_types+=("action")
        item_names+=("rename")

        items+=("🗑️   Hapus Akun")
        item_types+=("action")
        item_names+=("delete")

        items+=("❌  Keluar")
        item_types+=("action")
        item_names+=("quit")

        tput cup 0 0
        tput ed

        # Header
        echo -e "${C_BG_HDR}$(printf '%*s' $W '')${C_RESET}"
        center "${C_BOLD}${C_CYAN}⚡ ANTIGRAVITY ACCOUNT MANAGER${C_RESET}" $W
        center "${C_DIM}${C_GRAY}Pilih akun untuk login · agyauth${C_RESET}" $W
        echo -e "${C_BG_HDR}$(printf '%*s' $W '')${C_RESET}"
        echo ""

        # Panel Login sebagai
        draw_box "Login sebagai" $W

        if [ ${#all[@]} -eq 0 ]; then
            local msg="Belum ada akun. Pilih '➕ Buat Akun Baru' di bawah."
            local msg_clean=$(echo -e "$msg" | sed 's/\x1b\[[0-9;]*m//g')
            local msg_len=${#msg_clean}
            # Adjust by subtracting 1 because the emoji ➕ takes up 2 terminal columns but counts as 1 char in bash length
            local pad_len=$((W - 4 - msg_len - 1))
            [ $pad_len -lt 0 ] && pad_len=0
            local pad_spaces=$(printf '%*s' $pad_len '')
            echo -e "${C_CYAN}${BOX_V}${C_RESET}  ${C_GRAY}${msg}${C_RESET}${pad_spaces} ${C_CYAN}${BOX_V}${C_RESET}"
        fi

        local inner=$((W - 4))
        for i in "${!items[@]}"; do
            local label="${items[$i]}"
            local itype="${item_types[$i]}"

            # Skip separator sebagai item navigasi (tapi tetap tampil)
            if [ "$itype" == "sep" ]; then
                echo -e "${C_CYAN}${BOX_ML}$(hline $BOX_H $((W-2)))${BOX_MR}${C_RESET}"
                continue
            fi

            local clean=$(echo -e "$label" | sed 's/\x1b\[[0-9;]*m//g')
            local pad=$((inner - ${#clean}))
            [ $pad -lt 0 ] && pad=0

            if [ "$i" -eq "$selected" ]; then
                if [ "$itype" == "account" ]; then
                    echo -e "${C_CYAN}${BOX_V}${C_RESET} ${C_BG_SEL}${C_GREEN}${C_BOLD} ▶ ${label}$(printf '%*s' $pad '') ${C_RESET} ${C_CYAN}${BOX_V}${C_RESET}"
                else
                    echo -e "${C_CYAN}${BOX_V}${C_RESET} ${C_BG_SEL}${C_YELLOW}${C_BOLD} ❯ ${label}$(printf '%*s' $pad '') ${C_RESET} ${C_CYAN}${BOX_V}${C_RESET}"
                fi
            else
                if [ "$itype" == "account" ]; then
                    echo -e "${C_CYAN}${BOX_V}${C_RESET}   ${label}$(printf '%*s' $((pad+1)) '')${C_CYAN}${BOX_V}${C_RESET}"
                else
                    echo -e "${C_CYAN}${BOX_V}${C_RESET}   ${C_DIM}${label}${C_RESET}$(printf '%*s' $((pad+1)) '')${C_CYAN}${BOX_V}${C_RESET}"
                fi
            fi
        done

        draw_box_bottom $W
        echo ""
        echo -e " ${C_DIM}${C_GRAY}↑↓ / j k Navigate   Enter Login/Select   q Quit${C_RESET}"
        echo -e " ${C_DIM}${C_GRAY}● OK  ◑ Expiring  ⚠ Warning  ✗ Expired  ○ No Token${C_RESET}"

        # Skip separator saat navigasi
        local k=$(read_key)
        case $k in
            UP)
                ((selected--))
                [ $selected -lt 0 ] && selected=$((${#items[@]}-1))
                # Skip separator
                while [ "${item_types[$selected]}" == "sep" ]; do
                    ((selected--))
                    [ $selected -lt 0 ] && selected=$((${#items[@]}-1))
                done
                ;;
            DOWN)
                ((selected++))
                [ $selected -ge ${#items[@]} ] && selected=0
                # Skip separator
                while [ "${item_types[$selected]}" == "sep" ]; do
                    ((selected++))
                    [ $selected -ge ${#items[@]} ] && selected=0
                done
                ;;
            ENTER|RIGHT)
                local sel_type="${item_types[$selected]}"
                local sel_name="${item_names[$selected]}"
                if [ "$sel_type" == "account" ]; then
                    # Switch symlink lalu launch agy
                    rm -f "$ORIGINAL"
                    ln -sf "$BASE/agy-$sel_name" "$ORIGINAL"
                    tput cnorm; tput rmcup
                    echo -e "${C_GREEN}▶ Launching agy sebagai: ${C_BOLD}$sel_name${C_RESET}"
                    exec agy "$@"
                elif [ "$sel_type" == "action" ]; then
                    case "$sel_name" in
                        new)    tput cnorm; create_account ;;
                        rename) tput cnorm; rename_account ;;
                        delete) tput cnorm; delete_account ;;
                        quit)   tput cnorm; tput rmcup; exit 0 ;;
                    esac
                fi
                ;;
            QUIT) tput cnorm; tput rmcup; exit 0 ;;
        esac
    done
}


# ════════════════════════════════════════════════════════════════
# ── SWITCH ACCOUNT ──────────────────────────────────────────────
# ════════════════════════════════════════════════════════════════
switch_account() {
    local W=70
    local all=($(get_all_accounts))
    if [ ${#all[@]} -eq 0 ]; then
        tput cup 0 0; tput ed
        draw_box "Switch Akun" $W
        box_empty $W
        echo -e "${C_CYAN}${BOX_V}${C_RESET}  ${C_RED}Belum ada akun. Jalankan 'agy-setup' dulu.${C_RESET}  ${C_CYAN}${BOX_V}${C_RESET}"
        box_empty $W
        draw_box_bottom $W
        read -p " Tekan Enter..."
        return
    fi

    local ACTIVE=$(get_active_account)
    local options=()
    for name in "${all[@]}"; do
        local exp=$(get_expiry_plain "$BASE/agy-$name")
        local iid=$(get_install_id "$BASE/agy-$name")
        local status=$(get_token_status "$BASE/agy-$name")
        local badge=""
        case $status in
            ok)      badge="${C_GREEN}●${C_RESET}" ;;
            expiring) badge="${C_YELLOW}◑${C_RESET}" ;;
            warning) badge="${C_RED}⚠${C_RESET}" ;;
            expired) badge="${C_RED}✗${C_RESET}" ;;
            *)       badge="${C_GRAY}○${C_RESET}" ;;
        esac
        if [ "$name" == "$ACTIVE" ]; then
            options+=("$badge ${C_BOLD}${name}${C_RESET} ${C_CYAN}[ACTIVE]${C_RESET}  ID:${iid}  ${exp}")
        else
            options+=("$badge ${name}  ID:${iid}  ${exp}")
        fi
    done
    options+=("${C_GRAY}← Kembali${C_RESET}")

    local selected=0
    while true; do
        tput cup 0 0; tput ed

        draw_box "Switch Akun — Pilih Akun Target" $W
        box_empty $W
        render_menu options $selected $W
        box_empty $W
        draw_box_bottom $W
        echo ""
        echo -e " ${C_DIM}${C_GRAY}● OK  ◑ Expiring  ⚠ Warning  ✗ Expired${C_RESET}"
        echo -e " ${C_DIM}${C_GRAY}↑↓ Navigate   Enter Select   q Cancel${C_RESET}"

        local k=$(read_key)
        case $k in
            UP)    ((selected--)); [ $selected -lt 0 ] && selected=$((${#options[@]}-1)) ;;
            DOWN)  ((selected++)); [ $selected -ge ${#options[@]} ] && selected=0 ;;
            ENTER|RIGHT) break ;;
            QUIT)  return ;;
        esac
    done

    tput cnorm
    if [ "$selected" -lt "${#all[@]}" ]; then
        local target="${all[$selected]}"
        rm -f "$ORIGINAL"
        ln -sf "$BASE/agy-$target" "$ORIGINAL"

        tput cup 0 0; tput ed
        echo ""
        center "${C_GREEN}${C_BOLD}✔ Berhasil Switch!${C_RESET}" $W
        echo ""
        draw_box "Status" $W
        box_row "Akun Aktif"     "${C_GREEN}${C_BOLD}$target${C_RESET}" $W
        box_row "Install ID"     "${C_YELLOW}$(get_install_id "$BASE/agy-$target")...${C_RESET}" $W
        box_row "History Shared" "${C_GREEN}✓ Tetap terbagi${C_RESET}" $W
        box_row "Config Shared"  "${C_GREEN}✓ Tetap terbagi${C_RESET}" $W
        box_row "Isolation"      "${C_GREEN}✓ Token & ID unik${C_RESET}" $W
        box_empty $W
        draw_box_bottom $W
        echo ""
        read -p " Tekan Enter untuk kembali..."
    fi
}

# ════════════════════════════════════════════════════════════════
# ── CREATE ACCOUNT ──────────────────────────────────────────────
# ════════════════════════════════════════════════════════════════
create_account() {
    local W=62
    tput cup 0 0; tput ed; tput cnorm

    echo ""
    draw_box "Buat Akun Baru" $W
    box_empty $W
    echo -e "${C_CYAN}${BOX_V}${C_RESET}  ${C_GRAY}Setiap akun akan memiliki:${C_RESET}$(printf '%*s' 25 '')${C_CYAN}${BOX_V}${C_RESET}"
    echo -e "${C_CYAN}${BOX_V}${C_RESET}  ${C_GREEN}✓${C_RESET} installation_id unik (baru & random)$(printf '%*s' 12 '')${C_CYAN}${BOX_V}${C_RESET}"
    echo -e "${C_CYAN}${BOX_V}${C_RESET}  ${C_GREEN}✓${C_RESET} Token OAuth terpisah$(printf '%*s' 28 '')${C_CYAN}${BOX_V}${C_RESET}"
    echo -e "${C_CYAN}${BOX_V}${C_RESET}  ${C_CYAN}🔗${C_RESET} History & config terbagi via symlink$(printf '%*s' 13 '')${C_CYAN}${BOX_V}${C_RESET}"
    box_empty $W
    draw_box_bottom $W
    echo ""
    read -p " Nama akun baru (misal: akun2, kantor): " name
    if [ -n "$name" ]; then
        echo ""
        agy-new "$name"
        echo ""
        echo -e " ${C_GREEN}${C_BOLD}✔ Selesai!${C_RESET} Jalankan ${C_YELLOW}agy-${name}${C_RESET} untuk login ke akun ini."
    else
        echo -e " ${C_RED}Dibatalkan.${C_RESET}"
    fi
    echo ""
    read -p " Tekan Enter untuk kembali..."
}

# ════════════════════════════════════════════════════════════════
# ── LIST ACCOUNTS ───────────────────────────────────════════════
# ════════════════════════════════════════════════════════════════
list_accounts() {
    local W=72
    local ACTIVE=$(get_active_account)
    tput cup 0 0; tput ed; tput cnorm

    echo ""
    draw_box "Semua Akun Antigravity" $W
    box_empty $W

    # Header kolom
    echo -e "${C_CYAN}${BOX_V}${C_RESET}  ${C_BOLD}${C_WHITE}$(printf '%-12s %-10s %-10s %-8s %s' 'NAMA' 'INSTALL ID' 'STATUS' 'TOKEN' 'EXPIRY')${C_RESET}$(printf '%*s' 4 '')${C_CYAN}${BOX_V}${C_RESET}"
    echo -e "${C_CYAN}${BOX_ML}$(hline '─' $((W-2)))${BOX_MR}${C_RESET}"

    local count=0
    for name in $(get_all_accounts); do
        local iid=$(get_install_id "$BASE/agy-$name")
        local status=$(get_token_status "$BASE/agy-$name")
        local exp=$(get_expiry_plain "$BASE/agy-$name")
        local badge="" status_text=""

        case $status in
            ok)      badge="${C_GREEN}●${C_RESET}"; status_text="${C_GREEN}Active ${C_RESET}" ;;
            expiring) badge="${C_YELLOW}◑${C_RESET}"; status_text="${C_YELLOW}Expiring${C_RESET}" ;;
            warning) badge="${C_RED}⚠${C_RESET}"; status_text="${C_RED}Warning ${C_RESET}" ;;
            expired) badge="${C_RED}✗${C_RESET}"; status_text="${C_RED}Expired ${C_RESET}" ;;
            *)       badge="${C_GRAY}○${C_RESET}"; status_text="${C_GRAY}No Token${C_RESET}" ;;
        esac

        local cur_mark=""
        [ "$name" == "$ACTIVE" ] && cur_mark=" ${C_CYAN}◀${C_RESET}"

        echo -e "${C_CYAN}${BOX_V}${C_RESET} $badge ${C_BOLD}$(printf '%-11s' "$name")${C_RESET}${cur_mark} $(printf '%-10s' "${iid}...") $status_text  ${C_DIM}${exp}${C_RESET}$(printf '%*s' 2 '')${C_CYAN}${BOX_V}${C_RESET}"
        ((count++))
    done

    if [ $count -eq 0 ]; then
        echo -e "${C_CYAN}${BOX_V}${C_RESET}  ${C_GRAY}Belum ada akun. Jalankan 'agy-setup'.${C_RESET}$(printf '%*s' 22 '')${C_CYAN}${BOX_V}${C_RESET}"
    fi

    echo -e "${C_CYAN}${BOX_ML}$(hline '─' $((W-2)))${BOX_MR}${C_RESET}"
    echo -e "${C_CYAN}${BOX_V}${C_RESET}  ${C_GRAY}Total: ${C_WHITE}${count} akun${C_RESET}$(printf '%*s' $((W-14)) '')${C_CYAN}${BOX_V}${C_RESET}"
    echo -e "${C_CYAN}${BOX_V}${C_RESET}  ${C_GRAY}Shared: ${C_BLUE}~/.gemini/agy-shared/ ${C_GRAY}(history, config, knowledge)${C_RESET}$(printf '%*s' 3 '')${C_CYAN}${BOX_V}${C_RESET}"
    box_empty $W
    draw_box_bottom $W
    echo ""
    echo -e " ${C_DIM}${C_GRAY}◀ = Akun aktif saat ini${C_RESET}"
    echo ""
    read -p " Tekan Enter untuk kembali..."
}

# ════════════════════════════════════════════════════════════════
# ── DELETE ACCOUNT ──────────────────────────────────────────────
# ════════════════════════════════════════════════════════════════
delete_account() {
    local W=66
    local ACTIVE=$(get_active_account)
    local all=($(get_all_accounts))

    if [ ${#all[@]} -eq 0 ]; then
        tput cup 0 0; tput ed
        echo -e "\n ${C_RED}Belum ada akun.${C_RESET}\n"
        read -p " Tekan Enter..."; return
    fi

    local options=()
    for name in "${all[@]}"; do
        local exp=$(get_expiry_plain "$BASE/agy-$name")
        local iid=$(get_install_id "$BASE/agy-$name")
        if [ "$name" == "$ACTIVE" ]; then
            options+=("${C_GRAY}⊘ ${name} [AKTIF — tidak bisa dihapus]${C_RESET}")
        else
            options+=("${C_RED}✗${C_RESET} ${name}  ID:${iid}  ${exp}")
        fi
    done
    options+=("${C_GRAY}← Kembali${C_RESET}")

    local selected=0
    while true; do
        tput cup 0 0; tput ed

        draw_box "Hapus Akun" $W
        box_empty $W
        echo -e "${C_CYAN}${BOX_V}${C_RESET}  ${C_YELLOW}⚠ Token & installation_id akan dihapus permanen.${C_RESET}$(printf '%*s' 4 '')${C_CYAN}${BOX_V}${C_RESET}"
        echo -e "${C_CYAN}${BOX_V}${C_RESET}  ${C_GREEN}✓ History & config di agy-shared aman.${C_RESET}$(printf '%*s' 13 '')${C_CYAN}${BOX_V}${C_RESET}"
        box_empty $W
        echo -e "${C_CYAN}${BOX_ML}$(hline '─' $((W-2)))${BOX_MR}${C_RESET}"
        render_menu options $selected $W
        box_empty $W
        draw_box_bottom $W
        echo ""
        echo -e " ${C_DIM}${C_GRAY}↑↓ Navigate   Enter Select   q Cancel${C_RESET}"

        local k=$(read_key)
        case $k in
            UP)    ((selected--)); [ $selected -lt 0 ] && selected=$((${#options[@]}-1)) ;;
            DOWN)  ((selected++)); [ $selected -ge ${#options[@]} ] && selected=0 ;;
            ENTER) break ;;
            QUIT)  return ;;
        esac
    done

    tput cnorm
    if [ "$selected" -lt "${#all[@]}" ]; then
        local target="${all[$selected]}"
        if [ "$target" == "$ACTIVE" ]; then
            echo -e "\n ${C_RED}Tidak bisa menghapus akun yang sedang aktif!${C_RESET}\n"
        else
            echo ""
            draw_box "Konfirmasi Hapus" $W
            box_row "Akun"   "${C_RED}${C_BOLD}$target${C_RESET}" $W
            box_row "Action" "${C_RED}Hapus token & installation_id${C_RESET}" $W
            box_row "Safe"   "${C_GREEN}History & config tetap aman${C_RESET}" $W
            box_empty $W
            draw_box_bottom $W
            echo ""
            read -p " Yakin? (y/n): " confirm
            if [[ "$confirm" == "y" ]]; then
                # Deteksi sudo dan bin_dir
                local _SUDO="" _BIN=""
                if [ "$EUID" -ne 0 ] && command -v sudo &>/dev/null; then
                    _SUDO="sudo"; _BIN="/usr/local/bin"
                elif [ -w "/usr/local/bin" ]; then
                    _SUDO=""; _BIN="/usr/local/bin"
                else
                    _SUDO=""; _BIN="$HOME/.local/bin"
                fi
                rm -rf "$BASE/agy-$target"
                $_SUDO rm -f "$_BIN/agy-$target"
                echo -e "\n ${C_GREEN}✔ Akun '${target}' berhasil dihapus.${C_RESET}"
            else
                echo -e " ${C_GRAY}Dibatalkan.${C_RESET}"
            fi
        fi
        echo ""
        read -p " Tekan Enter untuk kembali..."
    fi
}

# ════════════════════════════════════════════════════════════════
# ── RENAME ACCOUNT ──────────────────────────────────────────────
# ════════════════════════════════════════════════════════════════
rename_account() {
    local W=66
    local ACTIVE=$(get_active_account)
    local all=($(get_all_accounts))

    if [ ${#all[@]} -eq 0 ]; then
        echo -e "\n ${C_RED}Belum ada akun.${C_RESET}\n"
        read -p " Tekan Enter..."; return
    fi

    local options=()
    for name in "${all[@]}"; do
        local iid=$(get_install_id "$BASE/agy-$name")
        if [ "$name" == "$ACTIVE" ]; then
            options+=("${C_BOLD}${name}${C_RESET} ${C_CYAN}[aktif]${C_RESET}  ID:${iid}")
        else
            options+=("${name}  ID:${iid}")
        fi
    done
    options+=("${C_GRAY}← Kembali${C_RESET}")

    local selected=0
    while true; do
        tput cup 0 0; tput ed

        draw_box "✏️  Rename Akun — Pilih Akun" $W
        box_empty $W
        render_menu options $selected $W
        box_empty $W
        draw_box_bottom $W
        echo ""
        echo -e " ${C_DIM}${C_GRAY}↑↓ Navigate   Enter Pilih   q Cancel${C_RESET}"

        local k=$(read_key)
        case $k in
            UP)    ((selected--)); [ $selected -lt 0 ] && selected=$((${#options[@]}-1)) ;;
            DOWN)  ((selected++)); [ $selected -ge ${#options[@]} ] && selected=0 ;;
            ENTER) break ;;
            QUIT)  return ;;
        esac
    done

    tput cnorm
    if [ "$selected" -ge "${#all[@]}" ]; then return; fi

    local OLD_NAME="${all[$selected]}"
    local OLD_DIR="$BASE/agy-$OLD_NAME"

    echo ""
    draw_box "Rename: $OLD_NAME" $W
    box_row "Akun saat ini" "${C_BOLD}${C_YELLOW}$OLD_NAME${C_RESET}" $W
    box_empty $W
    draw_box_bottom $W
    echo ""
    read -p " Nama baru: " NEW_NAME

    # Validasi
    if [ -z "$NEW_NAME" ]; then
        echo -e " ${C_RED}✗ Nama tidak boleh kosong. Dibatalkan.${C_RESET}"
        read -p " Tekan Enter..."; return
    fi
    if [ "$NEW_NAME" == "$OLD_NAME" ]; then
        echo -e " ${C_YELLOW}⚠ Nama sama, tidak ada perubahan.${C_RESET}"
        read -p " Tekan Enter..."; return
    fi
    if [ -d "$BASE/agy-$NEW_NAME" ]; then
        echo -e " ${C_RED}✗ Nama '$NEW_NAME' sudah dipakai oleh akun lain.${C_RESET}"
        read -p " Tekan Enter..."; return
    fi

    # Deteksi sudo
    if [ "$EUID" -ne 0 ] && command -v sudo &>/dev/null; then
        SUDO="sudo"; BIN_DIR="/usr/local/bin"
    elif [ -w "/usr/local/bin" ]; then
        SUDO=""; BIN_DIR="/usr/local/bin"
    else
        SUDO=""; BIN_DIR="$HOME/.local/bin"
    fi

    # 1. Rename direktori
    mv "$OLD_DIR" "$BASE/agy-$NEW_NAME"
    echo -e " ${C_GREEN}✔${C_RESET} Direktori: agy-${OLD_NAME} → agy-${NEW_NAME}"

    # 2. Update symlink aktif jika perlu
    if [ "$OLD_NAME" == "$ACTIVE" ]; then
        rm -f "$ORIGINAL"
        ln -sf "$BASE/agy-$NEW_NAME" "$ORIGINAL"
        echo -e " ${C_GREEN}✔${C_RESET} Symlink aktif diperbarui → agy-${NEW_NAME}"
    fi

    # 3. Hapus wrapper lama, buat wrapper baru
    $SUDO rm -f "$BIN_DIR/agy-$OLD_NAME"
    local TMP=$(mktemp)
    cat > "$TMP" <<EOF
#!/bin/bash
ACCT_DIR="$BASE/agy-$NEW_NAME"
ORIGINAL="$ORIGINAL"
rm -f "\$ORIGINAL"
ln -sf "\$ACCT_DIR" "\$ORIGINAL"
exec agy "\$@"
EOF
    $SUDO mv "$TMP" "$BIN_DIR/agy-$NEW_NAME"
    $SUDO chmod +x "$BIN_DIR/agy-$NEW_NAME"
    echo -e " ${C_GREEN}✔${C_RESET} Wrapper: agy-${OLD_NAME} → agy-${NEW_NAME}"

    echo ""
    echo -e " ${C_GREEN}${C_BOLD}✔ Rename berhasil!${C_RESET}  ${C_YELLOW}${OLD_NAME}${C_RESET} → ${C_GREEN}${NEW_NAME}${C_RESET}"
    echo ""
    read -p " Tekan Enter untuk kembali..."
}

# ════════════════════════════════════════════════════════════════
# ── HELP ────────────────────────────────────────────────────────
# ════════════════════════════════════════════════════════════════
show_help() {
    local W=66
    echo ""
    echo -e "${C_CYAN}${BOX_TL}$(hline $BOX_H $((W-2)))${BOX_TR}${C_RESET}"
    echo -e "${C_CYAN}${BOX_V}${C_RESET}$(printf '%*s' $((W-2)) '')${C_CYAN}${BOX_V}${C_RESET}"
    center "${C_BOLD}${C_CYAN}⚡ agyauth${C_RESET}${C_BOLD} — Antigravity Multi-Account Manager${C_RESET}" $W
    center "${C_DIM}${C_GRAY}https://github.com/galgunawan/agyauth${C_RESET}" $W
    echo -e "${C_CYAN}${BOX_V}${C_RESET}$(printf '%*s' $((W-2)) '')${C_CYAN}${BOX_V}${C_RESET}"
    echo -e "${C_CYAN}${BOX_BL}$(hline $BOX_H $((W-2)))${BOX_BR}${C_RESET}"
    echo ""

    # Usage
    echo -e " ${C_BOLD}${C_WHITE}USAGE${C_RESET}"
    echo -e "   ${C_CYAN}agyauth${C_RESET}                       Buka TUI account manager"
    echo -e "   ${C_CYAN}agyauth${C_RESET} ${C_YELLOW}<flag> [argumen]${C_RESET}   Lihat OPTIONS di bawah"
    echo ""

    # Options
    echo -e " ${C_BOLD}${C_WHITE}OPTIONS${C_RESET}"
    echo -e "   ${C_YELLOW}-h,  --help${C_RESET}                  Tampilkan help ini"
    echo -e "   ${C_YELLOW}-v,  --version${C_RESET}               Tampilkan versi agyauth"
    echo -e "   ${C_YELLOW}-l,  --list${C_RESET}                  List semua akun + status token"
    echo -e "   ${C_YELLOW}-a,  --active${C_RESET}                Tampilkan akun yang sedang aktif"
    echo -e "   ${C_YELLOW}-s,  --switch${C_RESET} ${C_WHITE}<nama>${C_RESET}        Switch ke akun tanpa membuka TUI"
    echo -e "   ${C_YELLOW}-rn, --rename${C_RESET} ${C_WHITE}<lama> <baru>${C_RESET}  Rename akun tanpa membuka TUI"
    echo ""

    # Related Commands
    echo -e " ${C_BOLD}${C_WHITE}RELATED COMMANDS${C_RESET}"
    echo -e "   ${C_CYAN}agy-setup${C_RESET}                    Setup awal multi-account (jalankan sekali)"
    echo -e "   ${C_CYAN}agy-new${C_RESET} ${C_YELLOW}<nama>${C_RESET}              Tambah akun baru dengan isolated ID"
    echo -e "   ${C_CYAN}agy-<nama>${C_RESET}                   Switch & langsung jalankan akun tertentu"
    echo ""

    # Examples
    echo -e " ${C_BOLD}${C_WHITE}EXAMPLES${C_RESET}"
    echo -e "   ${C_DIM}# Setup awal — jalankan sekali di server baru${C_RESET}"
    echo -e "   ${C_CYAN}agy-setup${C_RESET}"
    echo ""
    echo -e "   ${C_DIM}# Tambah akun baru${C_RESET}"
    echo -e "   ${C_CYAN}agy-new${C_RESET} ${C_YELLOW}akun2${C_RESET}"
    echo ""
    echo -e "   ${C_DIM}# Buka TUI — pilih akun lalu langsung login${C_RESET}"
    echo -e "   ${C_CYAN}agyauth${C_RESET}"
    echo ""
    echo -e "   ${C_DIM}# Switch akun cepat tanpa buka TUI${C_RESET}"
    echo -e "   ${C_CYAN}agyauth -s${C_RESET} ${C_YELLOW}utama${C_RESET}"
    echo -e "   ${C_CYAN}agyauth --switch${C_RESET} ${C_YELLOW}akun2${C_RESET}"
    echo ""
    echo -e "   ${C_DIM}# Rename akun${C_RESET}"
    echo -e "   ${C_CYAN}agyauth --rename${C_RESET} ${C_YELLOW}namajeleq namabenar${C_RESET}"
    echo ""
    echo -e "   ${C_DIM}# Shortcut langsung jalankan akun tanpa TUI${C_RESET}"
    echo -e "   ${C_CYAN}agy-utama${C_RESET}        ${C_GRAY}(switch + jalankan agy sebagai utama)${C_RESET}"
    echo -e "   ${C_CYAN}agy-akun2${C_RESET}        ${C_GRAY}(switch + jalankan agy sebagai akun2)${C_RESET}"
    echo ""
    echo -e "   ${C_DIM}# Cek siapa yang aktif${C_RESET}"
    echo -e "   ${C_CYAN}agyauth -a${C_RESET}"
    echo ""

    # Directory structure
    echo -e " ${C_BOLD}${C_WHITE}DIRECTORY STRUCTURE${C_RESET}"
    echo -e "   ${C_BLUE}~/.gemini/agy-shared/${C_RESET}      ${C_GRAY}← dibagi semua akun (history, settings, knowledge)${C_RESET}"
    echo -e "   ${C_BLUE}~/.gemini/agy-<nama>/${C_RESET}      ${C_GRAY}← tiap akun: token + installation_id unik${C_RESET}"
    echo -e "   ${C_BLUE}~/.gemini/antigravity-cli${C_RESET}  ${C_GRAY}← symlink → akun yang sedang aktif${C_RESET}"
    echo ""
}

# ════════════════════════════════════════════════════════════════
# ── ENTRY POINT ─────────────────────────────────────────────────
# ════════════════════════════════════════════════════════════════

# Parse arguments
case "${1:-}" in
    -h|--help|help)
        show_help
        exit 0
        ;;
    -v|--version|version)
        echo -e "${C_CYAN}agyauth${C_RESET} v1.0.0 — https://github.com/galgunawan/agyauth"
        exit 0
        ;;
    -a|--active|active)
        ACTIVE=$(get_active_account)
        ACCT_DIR="$BASE/agy-$ACTIVE"
        EXP=$(get_expiry_plain "$ACCT_DIR")
        IID=$(get_install_id "$ACCT_DIR")
        echo -e "${C_GREEN}● ${C_BOLD}$ACTIVE${C_RESET}  ID:${IID}  Exp:${EXP}"
        exit 0
        ;;
    -l|--list|list)
        echo ""
        echo -e " ${C_BOLD}Daftar Akun Antigravity:${C_RESET}"
        echo ""
        ACTIVE=$(get_active_account)
        for dir in "$BASE"/agy-*/; do
            name=$(basename "$dir" | sed 's/^agy-//')
            [ "$name" = "shared" ] && continue
            exp=$(get_expiry_plain "$dir")
            iid=$(get_install_id "$dir")
            status=$(get_token_status "$dir")
            badge=""
            case $status in
                ok)       badge="${C_GREEN}●${C_RESET}" ;;
                expiring) badge="${C_YELLOW}◑${C_RESET}" ;;
                warning)  badge="${C_RED}⚠${C_RESET}" ;;
                expired)  badge="${C_RED}✗${C_RESET}" ;;
                *)        badge="${C_GRAY}○${C_RESET}" ;;
            esac
            mark=""
            [ "$name" = "$ACTIVE" ] && mark=" ${C_CYAN}← aktif${C_RESET}"
            echo -e "   $badge ${C_BOLD}$(printf '%-15s' "$name")${C_RESET}  ID:${iid}  ${exp}${mark}"
        done
        echo ""
        exit 0
        ;;
    -s|--switch|switch)
        TARGET="${2:-}"
        if [ -z "$TARGET" ]; then
            echo -e "${C_RED}✗ Nama akun diperlukan. Contoh: agyauth --switch utama${C_RESET}"
            exit 1
        fi
        if [ ! -d "$BASE/agy-$TARGET" ]; then
            echo -e "${C_RED}✗ Akun '$TARGET' tidak ditemukan.${C_RESET}"
            echo -e "  Gunakan ${C_CYAN}agyauth --list${C_RESET} untuk melihat akun yang tersedia."
            exit 1
        fi
        rm -f "$ORIGINAL"
        ln -sf "$BASE/agy-$TARGET" "$ORIGINAL"
        echo -e "${C_GREEN}✔ Switched ke akun: ${C_BOLD}$TARGET${C_RESET}"
        exit 0
        ;;
    -rn|--rename|rename)
        OLD="${2:-}"; NEW="${3:-}"
        if [ -z "$OLD" ] || [ -z "$NEW" ]; then
            echo -e "${C_RED}✗ Diperlukan 2 argumen. Contoh: agyauth --rename namalama namabaru${C_RESET}"
            exit 1
        fi
        if [ ! -d "$BASE/agy-$OLD" ]; then
            echo -e "${C_RED}✗ Akun '$OLD' tidak ditemukan.${C_RESET}"
            exit 1
        fi
        if [ -d "$BASE/agy-$NEW" ]; then
            echo -e "${C_RED}✗ Nama '$NEW' sudah dipakai.${C_RESET}"
            exit 1
        fi
        if [ "$EUID" -ne 0 ] && command -v sudo &>/dev/null; then
            _SUDO="sudo"; _BIN="/usr/local/bin"
        elif [ -w "/usr/local/bin" ]; then
            _SUDO=""; _BIN="/usr/local/bin"
        else
            _SUDO=""; _BIN="$HOME/.local/bin"
        fi
        mv "$BASE/agy-$OLD" "$BASE/agy-$NEW"
        echo -e " ${C_GREEN}✔${C_RESET} Direktori: agy-${OLD} → agy-${NEW}"
        ACTIVE=$(get_active_account)
        if [ "$OLD" == "$ACTIVE" ]; then
            rm -f "$ORIGINAL"
            ln -sf "$BASE/agy-$NEW" "$ORIGINAL"
            echo -e " ${C_GREEN}✔${C_RESET} Symlink aktif diperbarui → agy-${NEW}"
        fi
        $_SUDO rm -f "$_BIN/agy-$OLD"
        _TMP=$(mktemp)
        cat > "$_TMP" <<EOF
#!/bin/bash
ACCT_DIR="$BASE/agy-$NEW"
ORIGINAL="$ORIGINAL"
rm -f "\$ORIGINAL"
ln -sf "\$ACCT_DIR" "\$ORIGINAL"
exec agy "\$@"
EOF
        $_SUDO mv "$_TMP" "$_BIN/agy-$NEW"
        $_SUDO chmod +x "$_BIN/agy-$NEW"
        echo -e " ${C_GREEN}✔${C_RESET} Wrapper: agy-${OLD} → agy-${NEW}"
        echo -e "${C_GREEN}✔ Rename selesai: ${C_BOLD}${OLD}${C_RESET} ${C_GREEN}→ ${C_BOLD}${NEW}${C_RESET}"
        exit 0
        ;;
    "")
        # Tidak ada argument → buka TUI
        ;;
    *)
        echo -e "${C_RED}✗ Opsi tidak dikenal: $1${C_RESET}"
        echo -e "  Gunakan ${C_CYAN}agyauth --help${C_RESET} untuk melihat semua opsi."
        exit 1
        ;;
esac

# Cek setup
if [ ! -d "$SHARED" ]; then
    tput cnorm
    echo ""
    echo -e " ${C_YELLOW}${C_BOLD}⚠ Setup belum dijalankan!${C_RESET}"
    echo ""
    echo -e " Jalankan terlebih dahulu: ${C_GREEN}agy-setup${C_RESET}"
    echo ""
    read -p " Mau jalankan sekarang? (y/n): " confirm
    [[ "$confirm" == "y" ]] && agy-setup
    exit 0
fi

TUI_ACTIVE=1
tput smcup
tput civis
tput clear

while true; do
    show_main_menu
done

#!/bin/bash
# agyauth v2 — Antigravity Multi-Account Manager (Simple TUI)

BASE="$HOME/.gemini"
SHARED="$BASE/agy-shared"
ORIGINAL="$BASE/antigravity-cli"

# ── Colors ──────────────────────────────────────────────────────
C_RESET='\033[0m'
C_BOLD='\033[1m'
C_DIM='\033[2m'
C_GREEN='\033[38;5;84m'
C_CYAN='\033[38;5;51m'
C_BLUE='\033[38;5;75m'
C_YELLOW='\033[38;5;220m'
C_RED='\033[38;5;203m'
C_PURPLE='\033[38;5;141m'
C_WHITE='\033[38;5;255m'
C_GRAY='\033[38;5;240m'
C_BG_SEL='\033[48;5;236m'
C_BG_HDR='\033[48;5;234m'

# Track if TUI is active
TUI_ACTIVE=0
trap 'tput cnorm; [ $TUI_ACTIVE -eq 1 ] && tput rmcup; exit' INT TERM EXIT

# ── Center Text Helper ─────────────────────────────────────────
center() {
    local text="$1" width="${2:-80}"
    local clean=$(echo -e "$text" | sed 's/\x1b\[[0-9;]*m//g')
    local pad=$(( (width - ${#clean}) / 2 ))
    printf '%*s%b%s\n' "$pad" '' "$text" "$C_RESET"
}

# ── Get Account Data ────────────────────────────────────────────
get_expiry_plain() {
    local file="$1/antigravity-oauth-token"
    [ ! -f "$file" ] && echo "No Token" && return
    local raw=$(jq -r '.token.expiry // empty' "$file" 2>/dev/null)
    [ -z "$raw" ] && echo "No Expiry" && return
    TZ='Asia/Jakarta' date -d "$raw" '+%d %b %H:%M WIB' 2>/dev/null || echo "Invalid"
}

get_token_status() {
    local file="$1/antigravity-oauth-token"
    [ ! -f "$file" ] && echo "none" && return
    local raw=$(jq -r '.token.expiry // empty' "$file" 2>/dev/null)
    [ -z "$raw" ] && echo "none" && return
    local exp_ts=$(date -d "$raw" +%s 2>/dev/null)
    local now_ts=$(date +%s)
    local diff=$((exp_ts - now_ts))
    if [ $diff -lt 0 ]; then echo "expired"
    elif [ $diff -lt 1800 ]; then echo "warning"
    elif [ $diff -lt 7200 ]; then echo "expiring"
    else echo "ok"
    fi
}

get_install_id() {
    local file="$1/installation_id"
    [ -f "$file" ] && cat "$file" | cut -c1-8 || echo "N/A"
}

get_active_account() {
    [ -L "$ORIGINAL" ] && basename "$(readlink "$ORIGINAL")" | sed 's/^agy-//' || echo "unknown"
}

get_all_accounts() {
    for dir in "$BASE"/agy-*/; do
        [ -d "$dir" ] && [ "$(basename "$dir")" != "agy-shared" ] && basename "$dir" | sed 's/^agy-//'
    done
}

# ── Read Keyboard Input ─────────────────────────────────────────
read_key() {
    local key
    read -rsn1 key
    if [[ $key == $'\x1b' ]]; then
        read -rsn2 key2
        case "$key2" in
            '[A') echo "UP" ;;
            '[B') echo "DOWN" ;;
            '[C') echo "RIGHT" ;;
            '[D') echo "LEFT" ;;
            *) echo "ESC" ;;
        esac
    elif [[ $key == "" ]]; then echo "ENTER"
    else
        echo "$key"
    fi
}

# ════════════════════════════════════════════════════════════════
# ── MAIN MENU ───────────────────────────────────────────────────
# ════════════════════════════════════════════════════════════════
show_main_menu() {
    local selected=0

    while true; do
        local ACTIVE=$(get_active_account)
        local all=($(get_all_accounts))
        local acc_count=${#all[@]}

        # Build items list: accounts first, then actions
        local items=()
        local item_types=()   # "account", "action", "sep"
        local item_names=()   # account name or action name ("new", "rename", "delete", "quit")
        local item_keys=()    # hotkeys ('1'-'9', 'n', 'r', 'd', 'q')

        for i in "${!all[@]}"; do
            local name="${all[$i]}"
            local key_num=$((i + 1))
            items+=("$name")
            item_types+=("account")
            item_names+=("$name")
            if [ $key_num -le 9 ]; then
                item_keys+=("$key_num")
            else
                item_keys+=("")
            fi
        done

        items+=("Create New Account")
        item_types+=("action")
        item_names+=("new")
        item_keys+=("n")

        items+=("Rename Account")
        item_types+=("action")
        item_names+=("rename")
        item_keys+=("r")

        items+=("Delete Account")
        item_types+=("action")
        item_names+=("delete")
        item_keys+=("d")

        items+=("Exit")
        item_types+=("action")
        item_names+=("quit")
        item_keys+=("q")

        tput cup 0 0
        tput ed

        echo -e "${C_BOLD}${C_CYAN}ANTIGRAVITY ACCOUNT MANAGER${C_RESET}"
        echo -e "${C_GRAY}------------------------------------------------------------${C_RESET}"
        if [ "$ACTIVE" != "unknown" ]; then
            local exp=$(get_expiry_plain "$BASE/agy-$ACTIVE")
            local iid=$(get_install_id "$BASE/agy-$ACTIVE")
            echo -e "Active account: ${C_GREEN}${C_BOLD}$ACTIVE${C_RESET} (ID: $iid, Exp: $exp)"
        else
            echo -e "Active account: ${C_RED}None${C_RESET}"
        fi
        echo -e "${C_GRAY}------------------------------------------------------------${C_RESET}"
        echo ""

        echo -e "${C_BOLD}Accounts:${C_RESET}"
        if [ $acc_count -eq 0 ]; then
            echo -e "  (No accounts found. Press 'n' to create one)"
        fi

        # Draw accounts
        for i in "${!all[@]}"; do
            local name="${all[$i]}"
            local exp=$(get_expiry_plain "$BASE/agy-$name")
            local iid=$(get_install_id "$BASE/agy-$name")
            local status=$(get_token_status "$BASE/agy-$name")
            local status_text=""
            local color=""
            case $status in
                ok)       status_text="OK"      ; color=$C_GREEN ;;
                expiring) status_text="Expiring"; color=$C_YELLOW ;;
                warning)  status_text="Warning" ; color=$C_RED ;;
                expired)  status_text="Expired" ; color=$C_RED ;;
                *)        status_text="No Token"; color=$C_GRAY ;;
            esac

            local prefix="  "
            [ "$name" == "$ACTIVE" ] && prefix="* "
            
            local shortcut_str="   "
            if [ $((i+1)) -le 9 ]; then
                shortcut_str="[$((i+1))]"
            fi

            local line="${prefix}${shortcut_str} ${C_BOLD}${name}${C_RESET} (ID: ${iid}, Exp: ${exp}, Status: ${color}${status_text}${C_RESET})"

            if [ "$i" -eq "$selected" ]; then
                echo -e " > $line"
            else
                echo -e "   $line"
            fi
        done

        echo ""
        echo -e "${C_BOLD}Actions:${C_RESET}"
        
        # Draw actions
        for i in "${!items[@]}"; do
            [ "${item_types[$i]}" != "action" ] && continue
            
            local name="${items[$i]}"
            local act_key="${item_keys[$i]}"
            local line="  [${act_key}] ${name}"

            if [ "$i" -eq "$selected" ]; then
                echo -e " > $line"
            else
                echo -e "   $line"
            fi
        done

        echo ""
        echo -e "${C_GRAY}------------------------------------------------------------${C_RESET}"
        echo -e "Shortcuts: [1-9] Switch Account | [n] New | [r] Rename | [d] Delete | [q]/[x] Exit"
        echo -e "Navigation: Up/Down/j/k to select, Enter to confirm"

        # Get keypress
        local k=$(read_key)
        
        # Check if it matches any direct hotkey
        local handled=0
        for i in "${!item_keys[@]}"; do
            local key_map="${item_keys[$i]}"
            if [ -n "$key_map" ] && [ "$k" == "$key_map" ]; then
                local sel_type="${item_types[$i]}"
                local sel_name="${item_names[$i]}"
                execute_menu_item "$sel_type" "$sel_name"
                handled=1
                break
            fi
        done

        # Handle 'x' or 'X' as exit
        if [ $handled -eq 0 ] && { [ "$k" == "x" ] || [ "$k" == "X" ]; }; then
            tput cnorm; tput rmcup; exit 0
        fi

        # If not handled, apply standard navigation
        if [ $handled -eq 0 ]; then
            case $k in
                UP)
                    ((selected--))
                    [ $selected -lt 0 ] && selected=$((${#items[@]}-1))
                    ;;
                DOWN)
                    ((selected++))
                    [ $selected -ge ${#items[@]} ] && selected=0
                    ;;
                ENTER|RIGHT)
                    local sel_type="${item_types[$selected]}"
                    local sel_name="${item_names[$selected]}"
                    execute_menu_item "$sel_type" "$sel_name"
                    ;;
                QUIT)
                    tput cnorm; tput rmcup; exit 0
                    ;;
            esac
        fi
    done
}

execute_menu_item() {
    local sel_type="$1"
    local sel_name="$2"
    if [ "$sel_type" == "account" ]; then
        rm -f "$ORIGINAL"
        ln -sf "$BASE/agy-$sel_name" "$ORIGINAL"
        tput cnorm; tput rmcup
        echo -e "${C_GREEN}▶ Launching agy as: ${C_BOLD}$sel_name${C_RESET}"
        exec agy "$@"
    elif [ "$sel_type" == "action" ]; then
        case "$sel_name" in
            new)    tput cnorm; create_account ;;
            rename) tput cnorm; rename_account ;;
            delete) tput cnorm; delete_account ;;
            quit)   tput cnorm; tput rmcup; exit 0 ;;
        esac
    fi
}

# ── CREATE ACCOUNT ──────────────────────────────────────────────
create_account() {
    tput cup 0 0; tput ed; tput cnorm
    echo -e "${C_BOLD}CREATE NEW ACCOUNT${C_RESET}"
    echo -e "------------------------------------------------------------"
    echo -e "Each account will have:"
    echo -e "  - Unique installation_id (new device fingerprint)"
    echo -e "  - Isolated OAuth token"
    echo -e "  - Shared history and config via symlinks"
    echo ""
    read -p "New account name (e.g., account2, office): " name
    if [ -n "$name" ]; then
        echo ""
        agy-new "$name"
        echo ""
        echo -e "${C_GREEN}✔ Done!${C_RESET} Run ${C_YELLOW}agy-${name}${C_RESET} to log in to this account."
    else
        echo -e "${C_RED}Cancelled.${C_RESET}"
    fi
    echo ""
    read -p "Press Enter to go back..."
}

# ── DELETE ACCOUNT ──────────────────────────────────────────────
delete_account() {
    local ACTIVE=$(get_active_account)
    local all=($(get_all_accounts))

    if [ ${#all[@]} -eq 0 ]; then
        tput cup 0 0; tput ed
        echo -e "\n ${C_RED}No accounts found.${C_RESET}\n"
        read -p "Press Enter to go back..."; return
    fi

    tput cup 0 0; tput ed; tput cnorm
    echo -e "${C_BOLD}DELETE ACCOUNT${C_RESET}"
    echo -e "------------------------------------------------------------"
    echo -e "Warning: Token and installation_id will be permanently deleted."
    echo -e "History and config in agy-shared remain safe."
    echo ""

    for i in "${!all[@]}"; do
        local name="${all[$i]}"
        local iid=$(get_install_id "$BASE/agy-$name")
        if [ "$name" == "$ACTIVE" ]; then
            echo -e "  [$((i+1))] ${C_GRAY}${name} [ACTIVE - cannot be deleted]${C_RESET}"
        else
            echo -e "  [$((i+1))] ${C_RED}${name}${C_RESET} (ID: ${iid})"
        fi
    done
    echo -e "  [q] Cancel"
    echo ""

    read -p "Select account number to delete: " choice
    if [ "$choice" == "q" ] || [ "$choice" == "Q" ] || [ -z "$choice" ]; then
        echo -e "Cancelled."
        read -p "Press Enter to go back..."
        return
    fi

    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -le "${#all[@]}" ] && [ "$choice" -gt 0 ]; then
        local idx=$((choice - 1))
        local target="${all[$idx]}"
        if [ "$target" == "$ACTIVE" ]; then
            echo -e "\n${C_RED}Cannot delete the currently active account!${C_RESET}"
        else
            echo ""
            read -p "Are you sure you want to delete account '$target'? (y/n): " confirm
            if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
                local _SUDO="" _BIN=""
                if [ "$EUID" -ne 0 ] && command -v sudo &>/dev/null; then
                    _SUDO="sudo"; _BIN="/usr/local/bin"
                elif [ -w "/usr/local/bin" ]; then
                    _SUDO=""; _BIN="/usr/local/bin"
                else
                    _SUDO=""; _BIN="$HOME/.local/bin"
                fi
                rm -rf "$BASE/agy-$target"
                $_SUDO rm -f "$_BIN/agy-$target"
                echo -e "\n${C_GREEN}✔ Account '${target}' successfully deleted.${C_RESET}"
            else
                echo -e "Cancelled."
            fi
        fi
    else
        echo -e "${C_RED}Invalid choice.${C_RESET}"
    fi
    echo ""
    read -p "Press Enter to go back..."
}

# ── RENAME ACCOUNT ──────────────────────────────────────────────
rename_account() {
    local ACTIVE=$(get_active_account)
    local all=($(get_all_accounts))

    if [ ${#all[@]} -eq 0 ]; then
        echo -e "\n ${C_RED}No accounts found.${C_RESET}\n"
        read -p "Press Enter to go back..."; return
    fi

    tput cup 0 0; tput ed; tput cnorm
    echo -e "${C_BOLD}RENAME ACCOUNT${C_RESET}"
    echo -e "------------------------------------------------------------"
    echo ""

    for i in "${!all[@]}"; do
        local name="${all[$i]}"
        local iid=$(get_install_id "$BASE/agy-$name")
        if [ "$name" == "$ACTIVE" ]; then
            echo -e "  [$((i+1))] ${C_BOLD}${name}${C_RESET} [active]"
        else
            echo -e "  [$((i+1))] ${name}"
        fi
    done
    echo -e "  [q] Cancel"
    echo ""

    read -p "Select account number to rename: " choice
    if [ "$choice" == "q" ] || [ "$choice" == "Q" ] || [ -z "$choice" ]; then
        echo -e "Cancelled."
        read -p "Press Enter to go back..."
        return
    fi

    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -le "${#all[@]}" ] && [ "$choice" -gt 0 ]; then
        local idx=$((choice - 1))
        local OLD_NAME="${all[$idx]}"
        local OLD_DIR="$BASE/agy-$OLD_NAME"

        echo ""
        read -p "Enter new name for '$OLD_NAME': " NEW_NAME

        if [ -z "$NEW_NAME" ]; then
            echo -e " ${C_RED}✗ Name cannot be empty. Cancelled.${C_RESET}"
            read -p "Press Enter to go back..."; return
        fi
        if [ "$NEW_NAME" == "$OLD_NAME" ]; then
            echo -e " ⚠ Name is the same, no changes made."
            read -p "Press Enter to go back..."; return
        fi
        if [ -d "$BASE/agy-$NEW_NAME" ]; then
            echo -e " ✗ Name '$NEW_NAME' is already used by another account."
            read -p "Press Enter to go back..."; return
        fi

        local _SUDO="" _BIN=""
        if [ "$EUID" -ne 0 ] && command -v sudo &>/dev/null; then
            _SUDO="sudo"; _BIN="/usr/local/bin"
        elif [ -w "/usr/local/bin" ]; then
            _SUDO=""; _BIN="/usr/local/bin"
        else
            _SUDO=""; _BIN="$HOME/.local/bin"
        fi

        mv "$OLD_DIR" "$BASE/agy-$NEW_NAME"
        echo -e " ✔ Directory: agy-${OLD_NAME} → agy-${NEW_NAME}"

        if [ "$OLD_NAME" == "$ACTIVE" ]; then
            rm -f "$ORIGINAL"
            ln -sf "$BASE/agy-$NEW_NAME" "$ORIGINAL"
            echo -e " ✔ Active symlink updated → agy-${NEW_NAME}"
        fi

        $_SUDO rm -f "$_BIN/agy-$OLD_NAME"
        local TMP=$(mktemp)
        cat > "$TMP" <<EOF
#!/bin/bash
ACCT_DIR="$BASE/agy-$NEW_NAME"
ORIGINAL="$ORIGINAL"
rm -f "\$ORIGINAL"
ln -sf "\$ACCT_DIR" "\$ORIGINAL"
exec agy "\$@"
EOF
        $_SUDO mv "$TMP" "$_BIN/agy-$NEW_NAME"
        $_SUDO chmod +x "$_BIN/agy-$NEW_NAME"
        echo -e " ✔ Wrapper: agy-${OLD_NAME} → agy-${NEW_NAME}"

        echo ""
        echo -e " ${C_GREEN}✔ Rename successful!${C_RESET}  ${C_YELLOW}${OLD_NAME}${C_RESET} → ${C_GREEN}${NEW_NAME}${C_RESET}"
    else
        echo -e "${C_RED}Invalid choice.${C_RESET}"
    fi
    echo ""
    read -p "Press Enter to go back..."
}

# ── HELP ────────────────────────────────────────────────────────
show_help() {
    echo ""
    echo -e "${C_BOLD}${C_CYAN}agyauth${C_RESET}${C_BOLD} — Antigravity Multi-Account Manager${C_RESET}"
    echo -e "https://github.com/galgunawan/agyauth"
    echo -e "------------------------------------------------------------"
    echo ""

    echo -e " ${C_BOLD}USAGE${C_RESET}"
    echo -e "   agyauth                       Open interactive TUI manager"
    echo -e "   agyauth <flag> [arguments]   See OPTIONS below"
    echo ""

    echo -e " ${C_BOLD}OPTIONS${C_RESET}"
    echo -e "   -h,  --help                  Show this help message"
    echo -e "   -v,  --version               Show version information"
    echo -e "   -l,  --list                  List all accounts and token status"
    echo -e "   -a,  --active                Show the currently active account"
    echo -e "   -s,  --switch <name>        Show an account without opening TUI"
    echo -e "   -rn, --rename <old> <new>  Rename an account without opening TUI"
    echo ""

    echo -e " ${C_BOLD}RELATED COMMANDS${C_RESET}"
    echo -e "   agy-setup                    First-time multi-account setup (run once)"
    echo -e "   agy-new <name>              Add a new account with isolated ID"
    echo -e "   agy-<name>                   Switch and run a specific account directly"
    echo ""

    echo -e " ${C_BOLD}EXAMPLES${C_RESET}"
    echo -e "   # First-time setup — run once on a new server"
    echo -e "   agy-setup"
    echo ""
    echo -e "   # Create a new account"
    echo -e "   agy-new account2"
    echo ""
    echo -e "   # Open interactive TUI manager"
    echo -e "   agyauth"
    echo ""
    echo -e "   # Quickly switch account without TUI"
    echo -e "   agyauth -s main"
    echo -e "   agyauth --switch account2"
    echo ""
    echo -e "   # Rename an account"
    echo -e "   agyauth --rename oldname newname"
    echo ""
    echo -e "   # Run account directly without TUI"
    echo -e "   agy-main          (switch + launch agy as main)"
    echo -e "   agy-account2      (switch + launch agy as account2)"
    echo ""
    echo -e "   # Check which account is active"
    echo -e "   agyauth -a"
    echo ""

    echo -e " ${C_BOLD}DIRECTORY STRUCTURE${C_RESET}"
    echo -e "   ~/.gemini/agy-shared/      ← shared by all accounts (history, settings, knowledge)"
    echo -e "   ~/.gemini/agy-<name>/      ← per account: unique token + installation_id"
    echo -e "   ~/.gemini/antigravity-cli  ← symlink → currently active account"
    echo ""
}

# ── ENTRY POINT ─────────────────────────────────────────────────

# Parse arguments
case "${1:-}" in
    -h|--help|help)
        show_help
        exit 0
        ;;
    -v|--version|version)
        echo -e "${C_CYAN}agyauth${C_RESET} v1.0.0 — https://github.com/galgunawan/agyauth"
        exit 0
        ;;
    -a|--active|active)
        ACTIVE=$(get_active_account)
        ACCT_DIR="$BASE/agy-$ACTIVE"
        EXP=$(get_expiry_plain "$ACCT_DIR")
        IID=$(get_install_id "$ACCT_DIR")
        echo -e "${C_GREEN}● ${C_BOLD}$ACTIVE${C_RESET}  ID:${IID}  Exp:${EXP}"
        exit 0
        ;;
    -l|--list|list)
        echo ""
        echo -e " ${C_BOLD}Antigravity Accounts List:${C_RESET}"
        echo ""
        ACTIVE=$(get_active_account)
        for dir in "$BASE"/agy-*/; do
            name=$(basename "$dir" | sed 's/^agy-//')
            [ "$name" = "shared" ] && continue
            exp=$(get_expiry_plain "$dir")
            iid=$(get_install_id "$dir")
            status=$(get_token_status "$dir")
            badge=" "
            case $status in
                ok)       badge="[OK] " ;;
                expiring) badge="[EXP] " ;;
                warning)  badge="[WAR] " ;;
                expired)  badge="[EXP] " ;;
                *)        badge="[N/A] " ;;
            esac
            mark=""
            [ "$name" = "$ACTIVE" ] && mark=" ← active"
            echo -e "   $badge ${C_BOLD}$(printf '%-15s' "$name")${C_RESET}  ID:${iid}  ${exp}${mark}"
        done
        echo ""
        exit 0
        ;;
    -s|--switch|switch)
        TARGET="${2:-}"
        if [ -z "$TARGET" ]; then
            echo -e "${C_RED}✗ Account name is required. Example: agyauth --switch main${C_RESET}"
            exit 1
        fi
        if [ ! -d "$BASE/agy-$TARGET" ]; then
            echo -e "${C_RED}✗ Account '$TARGET' not found.${C_RESET}"
            echo -e "  Use ${C_CYAN}agyauth --list${C_RESET} to view available accounts."
            exit 1
        fi
        rm -f "$ORIGINAL"
        ln -sf "$BASE/agy-$TARGET" "$ORIGINAL"
        echo -e "${C_GREEN}✔ Switched to account: ${C_BOLD}$TARGET${C_RESET}"
        exit 0
        ;;
    -rn|--rename|rename)
        OLD="${2:-}"; NEW="${3:-}"
        if [ -z "$OLD" ] || [ -z "$NEW" ]; then
            echo -e "${C_RED}✗ 2 arguments required. Example: agyauth --rename oldname newname${C_RESET}"
            exit 1
        fi
        if [ ! -d "$BASE/agy-$OLD" ]; then
            echo -e "${C_RED}✗ Account '$OLD' not found.${C_RESET}"
            exit 1
        fi
        if [ -d "$BASE/agy-$NEW" ]; then
            echo -e "${C_RED}✗ Name '$NEW' is already in use.${C_RESET}"
            exit 1
        fi
        if [ "$EUID" -ne 0 ] && command -v sudo &>/dev/null; then
            _SUDO="sudo"; _BIN="/usr/local/bin"
        elif [ -w "/usr/local/bin" ]; then
            _SUDO=""; _BIN="/usr/local/bin"
        else
            _SUDO=""; _BIN="$HOME/.local/bin"
        fi
        mv "$BASE/agy-$OLD" "$BASE/agy-$NEW"
        echo -e " / Directory: agy-${OLD} → agy-${NEW}"
        ACTIVE=$(get_active_account)
        if [ "$OLD" == "$ACTIVE" ]; then
            rm -f "$ORIGINAL"
            ln -sf "$BASE/agy-$NEW" "$ORIGINAL"
            echo -e " ✔ Active symlink updated → agy-${NEW}"
        fi
        $_SUDO rm -f "$_BIN/agy-$OLD"
        _TMP=$(mktemp)
        cat > "$_TMP" <<EOF
#!/bin/bash
ACCT_DIR="$BASE/agy-$NEW"
ORIGINAL="$ORIGINAL"
rm -f "\$ORIGINAL"
ln -sf "\$ACCT_DIR" "\$ORIGINAL"
exec agy "\$@"
EOF
        $_SUDO mv "$_TMP" "$_BIN/agy-$NEW"
        $_SUDO chmod +x "$_BIN/agy-$NEW"
        echo -e " ✔ Wrapper: agy-${OLD} → agy-${NEW}"
        echo -e "${C_GREEN}✔ Rename complete: ${C_BOLD}${OLD}${C_RESET} ${C_GREEN}→ ${C_BOLD}${NEW}${C_RESET}"
        exit 0
        ;;
    "")
        # No arguments → open TUI
        ;;
    *)
        echo -e "${C_RED}✗ Unknown option: $1${C_RESET}"
        echo -e "  Use ${C_CYAN}agyauth --help${C_RESET} to view all options."
        exit 1
        ;;
esac

# Check setup status
if [ ! -d "$SHARED" ]; then
    tput cnorm
    echo ""
    echo -e " ${C_YELLOW}${C_BOLD}⚠ Setup has not been run yet!${C_RESET}"
    echo ""
    echo -e " Please run this first: ${C_GREEN}agy-setup${C_RESET}"
    echo ""
    read -p " Would you like to run it now? (y/n): " confirm
    [[ "$confirm" == "y" ]] && agy-setup
    exit 0
fi

TUI_ACTIVE=1
tput smcup
tput civis
tput clear

while true; do
    show_main_menu
done
